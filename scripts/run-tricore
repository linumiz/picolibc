# Run one test on qemu-tricore: the TC397 model for TC1.6.2 ELFs and the
# TC4D7 model for TC1.8 ELFs. Each model fixes its own core, so no -cpu; the
# paravirt device prints the output and exits QEMU with the test status.

elf="$1"
shift

while [ $# -gt 0 ]; do
    case "$1" in
	--stdin)
	    echo "run-tricore: stdin not supported"
	    exit 77
	    ;;
	--args)
	    shift 2
	    ;;
	*)
	    break
	    ;;
    esac
done

flags=$(tricore-elf-readelf -h "$elf" | awk '/Flags:/ { sub(",", "", $2); print $2 }')
case "$flags" in
    0x100000)
	machine=KIT_AURIX_TC397B_TRB
	;;
    0x80000)
	machine=KIT_A3G_TC4D7_LITE
	;;
    *)
	echo "run-tricore: $elf has unknown core flags $flags" 1>&2
	exit 1
	;;
esac

exec qemu-system-tricore -machine "$machine" -display none -monitor none \
     -serial none -kernel "$elf" "$@"
